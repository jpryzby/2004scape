[proc,bot_cure_poison](int $slot)
if(%poison > 0){
    if(inv_total(bank,1doseantipoison) > 0){
        ~bot_bank_withdraw2(0_46_52_1_39,1doseantipoison,1);
    }else if(inv_total(bank,2doseantipoison) > 0){
        ~bot_bank_withdraw2(0_46_52_1_39,2doseantipoison,1);
    }else if(inv_total(bank,3doseantipoison) > 0){
        ~bot_bank_withdraw2(0_46_52_1_39,3doseantipoison,1);
    }else if(inv_total(bank,4doseantipoison) > 1){
        ~bot_bank_withdraw(0_46_52_1_39,4doseantipoison,1);
    }else{
        mes("out of antipoison");
        while(p_finduid(uid) = true){
            world_delay(100);
        }
    }
    ~player_consume_antipoison(null, null, $slot);
}
world_delay(1);



[proc,set_autocast_spell](int $spell)
if_close;
if (p_finduid(uid) = true) {
    def_dbrow $spell_data = ~get_spell_data($spell);
    if (~check_spell_requirements($spell_data) = false) {
