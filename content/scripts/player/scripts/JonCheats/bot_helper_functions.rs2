    facesquare(npc_coord);
    if(npc_getmode ! opplayer2 & npc_getmode ! applayer2) npc_setmode(playerfaceclose);
    world_delay(2);
    $page = calc($page + 1);
}






[proc,bot_multi2](string $string1, proc $label1, string $string2, proc $label2, int $bot_choice)
