[proc,bot_heal](coord $bank_coord)
def_obj $food = trout;
def_int $heal_amount = 7;
def_int $amount_to_heal = calc(stat_base(hitpoints) - stat(hitpoints)); 
def_int $food_withdraw_quantity = calc($amount_to_heal / $heal_amount);

//withdraw food
~bot_bank_withdraw($bank_coord,$food,$food_withdraw_quantity);
if_close;

while(inv_total(inv,$food) > 0 & p_finduid(uid) = true){
    ~bot_eat($food);
}




[proc,fight](npc $npc, int $range, coord $center)(coord)
def_coord $npcCoord = coord;

///if under attack
if(%aggressive_npc ! null & add(%lastcombat, 8) > map_clock){
    if(npc_finduid(%aggressive_npc) = true){
        mes("found");
        if(p_finduid(uid) = true){
            p_opnpc(2);
        }

        // While in combat
        while(p_finduid(uid) = true & npc_stat(hitpoints) > 0){
            p_opnpc(2);
            world_delay(1);
        }
        if_close;

        return(npc_coord);
    }else{
        mes("not found");
        world_delay(1);
    }
    
}else{
    if(npc_find(coord, $npc, $range, 0) = true){
        if(p_finduid(uid) = true){
            p_opnpc(2);
        }
        // While in combat
        while(p_finduid(uid) = true & npc_stat(hitpoints) > 0){
            mes("in combat");
            p_opnpc(2);
            world_delay(1);
        }
        if_close;

        return(npc_coord);
    }else{
        mes("Waiting for Enemy respawns");
        ~botwalk($center);
        world_delay(1);
    }
}




[proc,magic_teleport](int $spell)
if_close;
if (p_finduid(uid) = true) {
    // look for spell in db
    def_dbrow $spell_data = ~get_spell_data($spell);
    if (~check_spell_requirements($spell_data)= false) {
        return;
    }
    if (~wilderness_level(coord) > 20) {
        mes("A mysterious force blocks your teleport spell!");
        mes("You can't use this teleport after level 20 wilderness.");
        return;
    }
    if($spell = ^ardougne_teleport & %elena_progress < ^elena_complete) {
        mes("You must have completed Plague City to use this spell.");
        return;
    }
    if($spell = ^watchtower_teleport & %itwatchtower_progress < ^itwatchtower_complete) {
        mes("You must have completed Watch Tower to use this spell.");
        return;
    }
    // https://www.reddit.com/r/2007scape/comments/b4vdki/watchtower_teleport_not_working_despite/, https://runescape.salmoneus.net/forums/topic/212538-cant-do-ardougne-tele-why-is-it-so/
    if(($spell = ^ardougne_teleport & %elena_progress < ^elena_complete_read_scroll) | ($spell = ^watchtower_teleport & %itwatchtower_progress < ^itwatchtower_complete_read_scroll)) {
        mes("You havn't learnt how to cast this spell yet.");
        return;
    }
    if (~pre_tele_checks(coord) = false) {
        return;
    }
    if (afk_event = ^true) {
        ~macro_event_general_spawn(~macro_event_set_random);
        return;
    }
    // delete runes and give xp
    ~delete_spell_runes($spell_data);
    ~give_spell_xp($spell_data);
    // give additional affects
    // teleport player. Always a radius of 2
    ~player_teleport_normal(map_findsquare(db_getfield($spell_data, magic_spell_table:tele_coord, 0), 0, 2, ^map_findsquare_lineofwalk));
}


