    ~bot_bank_withdraw(0_46_52_1_39,gold_bar,12);
    ~bot_bank_withdraw(0_46_52_1_39,uncut_ruby,12);

    while(inv_total(inv,uncut_ruby) > 0){
        ~crafting_gem(uncut_ruby);
    }

    ~botwalk(0_46_52_30_42);
    facesquare(0_46_52_31_40);
