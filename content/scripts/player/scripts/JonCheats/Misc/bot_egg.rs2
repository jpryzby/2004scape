~bot_bank_withdraw(0_46_52_1_39,ring_mould,1);
~bot_bank_withdraw(0_46_52_1_39,cosmicrune,^max_32bit_int);
~bot_bank_withdraw(0_46_52_1_39,fire_battlestaff,1);

~try_equip(3);

