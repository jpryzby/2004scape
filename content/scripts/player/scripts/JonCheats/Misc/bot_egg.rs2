[proc,hellhound]

def_coord $safespot = 0_44_153_37_51;

~botwalk(0_44_153_37_51);

while(p_finduid(uid) = true){
    def_coord $npcCoord = ~fight_with_safespot($safespot, hellhound, 10);
    ~loot_hellhound($npcCoord);
}




[proc,fight_with_safespot](coord $safespot, npc $npc, int $range)(coord)
if(npc_find($safespot, $npc, $range, ^vis_off) = true){
    p_opnpc(2);
    ~walk_to_safe_spot($safespot);
    while(p_finduid(uid) = true & npc_stat(hitpoints) > 0){
        mes("in combat");
        p_opnpc(2);
        world_delay(2);
        if(coord ! $safespot){
            ~walk_to_safe_spot($safespot);
        }
    }
    if_close;
    return(npc_coord);
}
return(coord);













[proc,buy_varrok]
mes("Buying from the shops in Varrok");
while(inv_total(inv,coins) > 100){
    ~bot_open_shop(0_50_53_33_33, lowe);
    while(inv_getnum(archeryshop, 0) > 1910 & inv_getnum(archeryshop, 1) > 1475 & p_finduid(uid) = true & inv_total(inv,coins) > 1000){
        ~buy_stackable_item(archeryshop, 0, 1910, bronze_arrow);
        ~buy_stackable_item(archeryshop, 1, 1475, iron_arrow);
        world_delay(1);
    }
    if_close;


    ~bot_open_shop(0_50_53_53_9, aubury);
    while(inv_getnum(runeshop, 0) > 1980 & inv_getnum(runeshop, 1) > 1980 & inv_getnum(runeshop, 2) > 1980 & inv_getnum(runeshop, 3) > 1980 & inv_getnum(runeshop, 4) > 975 & inv_total(inv, coins) > 1000 & p_finduid(uid) = true){
        ~buy_stackable_item(runeshop, 0, 1980, firerune);
        ~buy_stackable_item(runeshop, 1, 1980, waterrune);
        ~buy_stackable_item(runeshop, 2, 1980, airrune);
        ~buy_stackable_item(runeshop, 3, 1980, earthrune);
        ~buy_stackable_item(runeshop, 4, 975, mindrune);
        ~buy_stackable_item(runeshop, 6, 499, chaosrune);
        ~buy_stackable_item(runeshop, 7, 499, deathrune);

        world_delay(1);
    }
    world_delay(1);
    if_close;
}

