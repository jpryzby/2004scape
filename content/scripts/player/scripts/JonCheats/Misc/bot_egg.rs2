~cannon_train;



[proc,cannon_train]
mes("Cannon Train in Khazard Battlefield");

def_coord $saftey_spot = 0_39_50_29_43;

while(p_finduid(uid) = true){
    def_int $end_time = calc(map_clock + 2400);

    ~walk_from_bank_to_cannon;
    ~set_up_cannon;

    while(p_finduid(uid) = true & map_clock < $end_time & stat(hitpoints) > 20 & loc_find(%mcannon_coord,dwarf_multicannon1) = true & %mcannon_ammo > 0){
        //~fight_gnomes_and_khazards;
        ~loot_bones(0_39_50_29_43);
        ~loot_bones(0_39_50_29_51);
        ~loot_bones(0_39_50_37_43);
        ~loot_bones(0_39_50_37_51);
        if(coord ! $saftey_spot){
            ~walk_to_safe_spot($saftey_spot);
        }
        world_delay(5);
    }
    ~pick_up_cannon;
    ~walk_from_cannon_to_bank;
    ~bot_heal(0_41_51_32_19);
}



[proc,set_up_cannon]
def_coord $cannon_spot = 0_39_50_30_40;
if(inv_total(inv,twpart1) > 0 & inv_total(inv,twpart2) > 0 & inv_total(inv,twpart3) > 0 & inv_total(inv,twpart4) > 0 & p_finduid(uid) = true){
    inv_del(inv,twpart1,1);
    inv_del(inv,twpart2,1);
    inv_del(inv,twpart3,1);
    inv_del(inv,twpart4,1);
    
    loc_add($cannon_spot, dwarf_multicannon1, 0, centrepiece_straight, ^cannon_decay_length);
    %mcannon_coord = $cannon_spot;

    ~load_cannon;
    world_delay(5);
}



[proc,load_cannon]
if (%mcannon_ammo >= 30) {
    mes("The cannon is already full of ammo."); // osrs
    return;
}
def_int $count = min(sub(30, max(%mcannon_ammo, 0)), inv_total(inv, mcannonball));
// with one cannon ball, it'd still be plural: https://youtu.be/5itKFWuomiM&t=132
mes("You load the cannon with <tostring($count)> cannonballs."); // https://youtu.be/TeQXQDaawO0?t=239
%mcannon_ammo = add(%mcannon_ammo, $count);
inv_del(inv, mcannonball, $count);



[proc,fight_gnomes_and_khazards]
if(npc_find(coord, khazard_troop, 4, 0) = true){
    if(p_finduid(uid) = true){
        p_opnpc(2);
    }
}
else if(npc_find(coord, khazard_troop_spearmen, 4, 0) = true){
    if(p_finduid(uid) = true){
        p_opnpc(2);
    }
}
else if(npc_find(coord, terrorbird_mounted, 4, 0) = true){
    if(p_finduid(uid) = true){
        p_opnpc(2);
    }
}
else if(npc_find(coord, terrorbird_mountedspear, 4, 0) = true){
    if(p_finduid(uid) = true){
        p_opnpc(2);
    }
}

world_delay(5);
if_close;



[proc,pick_up_cannon]
while(%mcannon_ammo > 0){
    world_delay(1);
}
world_delay(1);
~bot_oploc(%mcannon_coord,dwarf_multicannon1,2);
world_delay(3);



[proc,loot_bones](coord $coord)
~load_cannon;
~fire_cannon;
obj_findallzone($coord);
while(p_finduid(uid) = true & obj_findnext() = true & inv_freespace(inv) > 0){//////////////////////////////this can be improved
    switch_obj(active_obj) {
        case bones : ~bury(bones);

        case bronze_arrow : ~pick_up(0);
        case iron_arrow : ~pick_up(0);
        case iron_knife : ~pick_up(0);

        case default : ~pick_up(1);
    }
    obj_findallzone($coord); 
}
equip_arrows;



