[proc,hunt_giants]
while(p_finduid(uid) = true){
    ~walk_from_bank_to_giants;
    ~hunt_giant;
    ~walk_from_giants_to_bank;
    ~bot_heal(0_49_53_50_44);
}




[proc,hunt_giant]
while(p_finduid(uid) = true & inv_freespace(inv) > 0 & stat(hitpoints) > 25){
    def_coord $loot_coord = ~fight(giant,20,0_48_153_45_52);
    ~loot_giant($loot_coord);
}




[proc,loot_giant](coord $loot_coord)
world_delay(2);
~botwalk($loot_coord);
obj_findallzone($loot_coord);
while(p_finduid(uid) = true & obj_findnext() = true & inv_freespace(inv) > 0){
    ~botwalk($loot_coord);
    switch_obj(active_obj) {
        case big_bones : ~pick_up(1);

        case bones : ~destroy;
        case coins : ~destroy;
        case beer : ~destroy;
        case waterrune : ~destroy;
        case firerune : ~destroy;
        case mindrune : ~destroy;
        case chaosrune : ~destroy;
        case deathrune : ~destroy;
        case naturerune : ~destroy;
        case iron_full_helm : ~destroy;
        case iron_kiteshield : ~destroy;
        case iron_dagger : ~destroy;
        case steel_longsword : ~destroy;
        case uncut_sapphire : ~destroy;
        case uncut_emerald : ~destroy;
        case body_talisman : ~destroy;

        case unidentified_guam : ~destroy;            //Attack Potion 3
        case unidentified_marrentill : ~destroy;      //Antipoison 5
        case unidentified_tarromin : ~destroy;        //Strength Potion 12
        case unidentified_harralander : ~destroy;     //Restore Potion 22         //Energy Potion 26
        case unidentified_irit : ~pick_up(1);         //Super Attack Potion 45    //Super antipoison
        case unidentified_ranarr : ~pick_up(1);       //Prayer Potion 38          //Defense Potion 30
        case unidentified_avantoe : ~pick_up(1);      //Fishing Potion 50
        case unidentified_kwuarm : ~pick_up(1);       //Super Strength Potion 55  //Weapon Poison 60
        case unidentified_cadantine : ~pick_up(1);    //Super Defense Potion 66
        case unidentified_lantadyme : ~pick_up(1);    //Antifire Potion 69
        case unidentified_dwarf_weed : ~pick_up(1);   //Ranging Potion 72

        case bronze_arrow : ~pick_up(0);
        case iron_arrow : ~pick_up(0);
        case iron_knife : ~pick_up(0);

        case default : ~pick_up(1);
    }
    obj_findallzone($loot_coord); 
}
equip_arrows;



