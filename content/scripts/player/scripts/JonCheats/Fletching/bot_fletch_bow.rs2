[debugproc,fletch_willow] ~fletch(willow_logs, willow_longbow, unstrung_willow_longbow);
[debugproc,fletch_maple] ~fletch(maple_logs, maple_longbow, unstrung_maple_longbow);
[debugproc,fletch_yew] ~fletch(yew_logs, yew_longbow, unstrung_yew_longbow);
[debugproc,fletch_magic] ~fletch(magic_logs, magic_longbow, unstrung_magic_longbow);



[proc,fletch](namedobj $log, namedobj $bowType, namedobj $unstrung_bowType)
mes("Fletching Bows");

~botwalk(0_46_52_1_41);
~botwalk(0_46_52_1_40);
~bot_bank_deposit_all(0_46_52_1_39,0);
~bot_bank_withdraw(0_46_52_1_39, knife, 1);

def_int $loop_count = 0;
while(p_finduid(uid) = true & inv_total(bank,$log) > 1 & inv_total(bank,bow_string) > 1){
    mes("You have completed <tostring($loop_count)> runs");

    ~bot_bank_withdraw(0_46_52_1_39, $log, 13);
    ~bot_bank_withdraw(0_46_52_1_39, bow_string, 13);
    ~bot_fletch_bow($log,$bowType);
    while(inv_total(inv,$unstrung_bowType) > 0 & inv_total(inv,bow_string) > 0 & p_finduid(uid) = true){
        ~bot_string_bow($unstrung_bowType);
    }

    ~bot_bank_deposit_all(0_46_52_1_39,1);
    
    $loop_count = calc($loop_count + 1);
}




[proc,bot_fletch_bow](obj $log, namedobj $bowType)



def_boolean $isLongbow = true;
//def_boolean $isLongbow = false;

while(inv_total(inv,$log) > 0 & p_finduid(uid) = true){

    db_find(fletch_bow_table:log, $log);
    def_dbrow $data = db_findnext;
    if ($data = null) {
        ~displaymessage(^dm_default);
        return;
    }

    def_int $fletching_experience = 0;
    def_int $level = 1;
    def_namedobj $product = $bowType;
    def_int $count = 1;
    def_string $message = "";

    if($isLongbow = true){
        $message = "You carefully cut the wood into a longbow.";
        $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:longbow, 0);
    }else{
        $message = "You carefully cut the wood into a shortbow.";
        $product, $level, $fletching_experience = db_getfield($data, fletch_bow_table:shortbow, 0);
    }

    inv_del(inv, $log, 1);
    mes($message);
    stat_advance(fletching, $fletching_experience);
    inv_add(inv, $product, $count);

    world_delay(1);
    if_close;

}