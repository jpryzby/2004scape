[proc,craft_hardlearther_bodies]
mes("Craft Hard Leather Bodies");

while(inv_total(inv,hard_leather) > 0 & p_finduid(uid) = true){
    ~craft_leather(hardleather_body);
}



[proc,craft_coifs]
mes("Craft Coifs");

while(inv_total(inv,leather) > 0 & p_finduid(uid) = true){
    ~craft_leather(coif);
}



[debugproc,make_coifs]
while(p_finduid(uid) = true & inv_total(bank,leather) > 1){
    ~craft_coifs;
    ~bot_bank_deposit_all(0_46_52_1_39,2);
    ~bot_bank_withdraw(0_46_52_1_39,leather,26);

}




