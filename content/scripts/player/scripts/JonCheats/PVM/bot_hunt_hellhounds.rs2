[debugproc,hunt_hellhounds]
mes("Hunting Hellhounds");

def_coord $safespot = 0_44_153_37_51;
~botwalk($safespot);

while(p_finduid(uid) = true){
    def_coord $npcCoord = ~fight_with_safespot($safespot, hellhound, 10);
    ~loot_hellhound($npcCoord);
}





[proc,loot_hellhound](coord $enemy_Coord)
world_delay(2);
~botwalk($enemy_Coord);
obj_findallzone($enemy_Coord);
while(p_finduid(uid) = true & obj_findnext() = true & inv_freespace(inv) > 0){
    ~botwalk($enemy_Coord);
    switch_obj(active_obj) {
        case bones : ~bury(bones);

        case bronze_arrow : ~pick_up(0);
        case iron_arrow : ~pick_up(0);
        case iron_knife : ~pick_up(0);

        case default : ~pick_up(1);
    }
    obj_findallzone($enemy_Coord); 
}
equip_arrows;