[debugproc,mine_coal]
mes("Mining Coal in Falador");

while(p_finduid(uid) = true){
    ~walk_from_bank_to_coal;
    ~mine_coal_rocks;
    ~walk_from_coal_to_bank;
    ~bot_bank_deposit_all(0_47_52_5_26,0);
}




[proc,walk_from_bank_to_coal]
~botrun(0,999,true);
~botwalk(0_47_52_13_11);
~bot_oploc(0_47_52_12_11,loc_2113,1);
world_delay(1);



[proc,walk_from_coal_to_bank]
~botwalk(0_47_152_13_11);
~bot_oploc(0_47_152_12_11,loc_1755,1);
world_delay(1);
~botwalk(0_47_52_5_27);



