[proc,loot_all_dragon_scales]
while(p_finduid(uid) = true & inv_freespace(inv) > 0){
    ~loot_dragon_scale(0_45_153_22_14);
    ~loot_dragon_scale(0_45_153_25_9);
    ~loot_dragon_scale(0_45_153_26_4);
    ~loot_dragon_scale(0_45_153_28_13);
    ~loot_dragon_scale(0_45_153_30_17);
    world_delay(1);
}
world_delay(1);



[proc,loot_dragon_scale](coord $dragon_scale_coord)
obj_findallzone($dragon_scale_coord);
while(p_finduid(uid) = true & obj_findnext() = true & inv_freespace(inv) > 0){
    switch_obj(active_obj) {
        case blue_dragon_scale : ~pick_up(1);
        case default : ~destroy;
    }
    obj_findallzone($dragon_scale_coord); 
}



[proc,walk_from_dragon_scales]
~magic_teleport(^falador_teleport);
world_delay(3);
~botwalk(0_46_52_1_40);



[proc,grind_dragon_scales]
def_int $slot = 5;
while(p_finduid(uid) = true & inv_total(inv,blue_dragon_scale) > 0){
    ~attempt_grind_ingredient(4, $slot);
    world_delay(1);
    $slot = calc($slot + 1);
}