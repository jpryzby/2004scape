~botwalk(0_45_153_8_38);
~bot_oploc(0_45_153_9_38,loc_2144,1);   //dark knight door
~bot_oploc(0_45_153_9_38,loc_2144,1);   //dark knight door
~bot_oploc(0_45_153_9_38,loc_2144,1);   //dark knight door
~botwalk(0_45_153_12_34);
~bot_oploc(0_45_153_12_34,loc_1542,1);
~botwalk(0_45_153_37_27);
