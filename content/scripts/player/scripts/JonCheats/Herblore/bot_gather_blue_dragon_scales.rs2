[debugproc,gather_dragon_scale]
mes("Gathering Blue Dragon Scale Dust");

~gear_check_for_dragon_scales;
while(p_finduid(uid) = true & inv_total(inv,airrune) > 2 & inv_total(inv,lawrune) > 0 & inv_total(inv,waterrune) > 0){
    ~walk_to_dragon_scales;
    ~loot_all_dragon_scales;
    ~walk_from_dragon_scales;
    ~grind_dragon_scales;
    ~bot_bank_deposit_all(0_46_52_1_39,5);
    ~bot_heal(0_46_52_1_39);
}





[proc,gear_check_for_dragon_scales]
~botwalk(0_46_52_1_41);
~botwalk(0_46_52_1_40);
~bot_bank_deposit_all(0_46_52_1_39,0);
~bot_bank_withdraw(0_46_52_1_39,airrune,^max_32bit_int);
~bot_bank_withdraw(0_46_52_1_39,waterrune,^max_32bit_int);
~bot_bank_withdraw(0_46_52_1_39,lawrune,^max_32bit_int);
~bot_bank_withdraw(0_46_52_1_39,dusty_key,1);
~bot_bank_withdraw(0_46_52_1_39,pestle_and_mortar,1);
if_close;



