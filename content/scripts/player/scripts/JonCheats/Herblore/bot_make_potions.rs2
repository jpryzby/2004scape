[proc,make_potion](namedobj $herb, namedobj $unid, namedobj $secondary_ingredient,namedobj $unf_potion)
def_struct $struct = ~get_brew_struct($unf_potion, $secondary_ingredient);
def_int $current_level = stat(herblore);
def_int $herb_level = struct_param($struct, brew_potion_level);
if ($current_level > $herb_level) {
    while(p_finduid(uid) = true & inv_total(bank,$unid) > 14 & inv_total(bank,$secondary_ingredient) > 14 & inv_total(bank,vial_water) > 14){
        ~bot_bank_withdraw(0_46_52_1_39,$unid,14);
        ~bot_bank_withdraw(0_46_52_1_39,vial_water,14);
        
        def_int $count = 0;
        while(inv_total(inv,$unid) > 0 & p_finduid(uid) = true){
            ~attempt_identify_herb($herb, $count);
            if_close;
            ~attempt_brew_potion($count, calc($count + 14));
            world_delay(1);
            $count = calc($count + 1);
        }

        ~bot_bank_withdraw(0_46_52_1_39,$secondary_ingredient,14);

        $count = 0;
        while(inv_total(inv, $secondary_ingredient) > 0 & p_finduid(uid) = true){
            ~attempt_brew_potion($count, calc($count + 14));
            world_delay(1);
            if_close;
            $count = calc($count + 1);
        }

        ~bot_bank_deposit_all(0_46_52_1_39,0);
    }
}

